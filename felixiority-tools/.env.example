APP_ORIGIN=https://tools.example.com
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Generate: openssl rand -hex 32
SESSION_SECRET=
SESSION_TTL_SECONDS=3600
ENABLE_BULK_DELETE=true
# Optional comma-separated exact hostnames. Empty permits public HTTPS hosts.
PANEL_ALLOWED_HOSTS=
# Use ONLY behind a proxy that OVERWRITES X-Real-IP, e.g. provided nginx config.
TRUST_PROXY=false
# Development only; never enable in production.
ALLOW_INSECURE_DEV=false
